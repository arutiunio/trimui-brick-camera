# BrickCam ESP-IDF defaults (tested with ESP-IDF 5.5.5)
# CI smoke test: this file is used by the reproducible GitHub Actions build.

# Flash / CPU / PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_USING_SYNOPSYS_DWC2_DRIVER=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# UART monitor
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
CONFIG_ESPTOOLPY_MONITOR_BAUD_CONSOLE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Freenove ESP32-S3 camera board + OV3660 pinout
CONFIG_CAMERA_MODULE_CUSTOM=y
CONFIG_CAMERA_XCLK_FREQ=20000000
CONFIG_CAMERA_PIN_PWDN=-1
CONFIG_CAMERA_PIN_RESET=-1
CONFIG_CAMERA_PIN_XCLK=15
CONFIG_CAMERA_PIN_SIOD=4
CONFIG_CAMERA_PIN_SIOC=5
CONFIG_CAMERA_PIN_VSYNC=6
CONFIG_CAMERA_PIN_HREF=7
CONFIG_CAMERA_PIN_PCLK=13
CONFIG_CAMERA_PIN_Y2=11
CONFIG_CAMERA_PIN_Y3=9
CONFIG_CAMERA_PIN_Y4=8
CONFIG_CAMERA_PIN_Y5=10
CONFIG_CAMERA_PIN_Y6=12
CONFIG_CAMERA_PIN_Y7=18
CONFIG_CAMERA_PIN_Y8=17
CONFIG_CAMERA_PIN_Y9=16

# JPEG framebuffer. The stable q2 baseline fits the automatic allocation.
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_AUTO=y

# UVC: 720p15 default plus the modes used by the Brick app.
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_UVC_MODE_ISOC_CAM1=y
CONFIG_FRAMESIZE_HD=y
CONFIG_UVC_CAM1_FRAMERATE=15
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=1280
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=720
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=y
CONFIG_UVC_MULTI_FRAME_WIDTH_1=640
CONFIG_UVC_MULTI_FRAME_HEIGHT_1=480
CONFIG_UVC_MULTI_FRAME_FPS_1=15
CONFIG_UVC_MULTI_FRAME_WIDTH_2=480
CONFIG_UVC_MULTI_FRAME_HEIGHT_2=320
CONFIG_UVC_MULTI_FRAME_FPS_2=30
CONFIG_UVC_MULTI_FRAME_WIDTH_3=320
CONFIG_UVC_MULTI_FRAME_HEIGHT_3=240
CONFIG_UVC_MULTI_FRAME_FPS_3=30
